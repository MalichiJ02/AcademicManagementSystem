@page
@model AcademicManagementSystem.Web.Pages.Coordinator.ResultsModel
@{
    ViewData["Title"] = "Results publication";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Coordinator workspace</p>
        <h1>Results entry and publication</h1>
        <p>Enter results only for confirmed registrations. Publication updates pass/fail records used by carry-course and progression checks.</p>
    </div>
    <span class="status-pill status-info">@Model.Settings.AcademicYear · @Model.Settings.Semester</span>
</section>

<section class="card-surface form-card mb-3">
    <h2>Enter marks by course</h2>
    <form method="get" asp-page="./Results" class="form-grid mb-3">
        <div>
            <label for="bulkProgramme" class="form-label">Programme</label>
            <select id="bulkProgramme" name="ProgrammeId" class="form-select" required>
                <option value="">Choose programme</option>
                @foreach (var programme in Model.Programmes)
                {
                    <option value="@programme.Id" selected="@(programme.Id == Model.ProgrammeId)">@programme.Code · @programme.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="bulkYear" class="form-label">Year of study</label>
            <select id="bulkYear" name="YearOfStudy" class="form-select" required>
                <option value="">Choose year</option>
                @foreach (var year in Model.StudyYears)
                {
                    <option value="@year" selected="@(year == Model.YearOfStudy)">Year @year</option>
                }
            </select>
        </div>
        <div class="align-self-end"><button class="btn btn-outline-primary" type="submit">Load courses</button></div>
    </form>

    @if (Model.ProgrammeId.HasValue && Model.YearOfStudy.HasValue)
    {
        if (Model.BulkCourses.Count == 0)
        {
            <p>No courses with confirmed registrations for this group in the current term.</p>
        }
        else
        {
            <form method="get" asp-page="./Results" class="form-grid mb-3">
                <input type="hidden" name="ProgrammeId" value="@Model.ProgrammeId" />
                <input type="hidden" name="YearOfStudy" value="@Model.YearOfStudy" />
                <div>
                    <label for="bulkCourse" class="form-label">Course</label>
                    <select id="bulkCourse" name="BulkCourseId" class="form-select" required>
                        <option value="">Choose course</option>
                        @foreach (var course in Model.BulkCourses)
                        {
                            <option value="@course.Id" selected="@(course.Id == Model.BulkCourseId)">@course.Code · @course.Title</option>
                        }
                    </select>
                </div>
                <div class="align-self-end"><button class="btn btn-outline-primary" type="submit">Load class list</button></div>
            </form>
        }
    }

    @if (Model.BulkRows.Count > 0)
    {
        <p>@Model.BulkRows.Count(row => row.Result?.IsPublished == false) draft ·
            @Model.BulkRows.Count(row => row.Result is null) missing ·
            @Model.BulkRows.Count(row => row.Result?.IsPublished == true) published</p>
        <form method="post" asp-page-handler="BulkRecord">
            <input type="hidden" name="ProgrammeId" value="@Model.ProgrammeId" />
            <input type="hidden" name="YearOfStudy" value="@Model.YearOfStudy" />
            <input type="hidden" name="BulkCourseId" value="@Model.BulkCourseId" />
            <div class="table-responsive">
                <table class="table align-middle directory-table">
                    <thead><tr><th scope="col">Student</th><th scope="col">Mark (%)</th><th scope="col">Status</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.BulkRows.Count; i++)
                        {
                            var row = Model.BulkRows[i];
                            <tr>
                                <td>@row.Student.StudentNumber · @row.Student.FullName</td>
                                <td>
                                    <input type="hidden" name="marks[@i].StudentId" value="@row.Student.Id" />
                                    @if (row.Result?.IsPublished == true)
                                    {
                                        @row.Result.Mark
                                    }
                                    else
                                    {
                                        <input type="number" name="marks[@i].Mark" class="form-control"
                                               value="@row.Result?.Mark.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                               min="0" max="100" step="0.01" aria-label="Mark for @row.Student.StudentNumber" />
                                    }
                                </td>
                                <td>@(row.Result is null ? "Missing" : row.Result.IsPublished ? "Published" : "Draft")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-primary mt-2" type="submit">Save draft marks</button>
        </form>
    }
</section>

<section class="card-surface form-card">
    <p class="section-kicker">Enter or correct a result</p>
    <h2>Unpublished result entry</h2>
    <form method="get" asp-page="./Results" class="form-grid mb-3">
        <div>
            <label asp-for="Search" class="form-label">Student ID or name</label>
            <input asp-for="Search" type="search" class="form-control" />
        </div>
        <div>
            <label asp-for="ProgrammeId" class="form-label">Programme</label>
            <select asp-for="ProgrammeId" class="form-select">
                <option value="">All programmes</option>
                @foreach (var programme in Model.Programmes)
                {
                    <option value="@programme.Id">@programme.Code · @programme.Name</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="YearOfStudy" class="form-label">Year of study</label>
            <select asp-for="YearOfStudy" class="form-select">
                <option value="">All years</option>
                @foreach (var year in Model.StudyYears)
                {
                    <option value="@year">Year @year</option>
                }
            </select>
        </div>
        <div class="align-self-end">
            <button class="btn btn-primary" type="submit">Search students</button>
            <a class="btn btn-outline-primary" asp-page="./Results">Clear filters</a>
        </div>
    </form>

    @if (Model.Students.Count == 0)
    {
        <p class="muted-copy">No students match your search and filters.</p>
    }
    else
    {
        <form method="get" asp-page="./Results" class="form-grid mb-3">
            <input name="Search" value="@Model.Search" type="hidden" />
            <input name="ProgrammeId" value="@Model.ProgrammeId" type="hidden" />
            <input name="YearOfStudy" value="@Model.YearOfStudy" type="hidden" />
            <div>
                <label for="resultStudent" class="form-label">Student</label>
                <select id="resultStudent" name="studentId" class="form-select" required>
                    <option value="">Choose student</option>
                    @foreach (var student in Model.Students)
                    {
                        <option value="@student.Id" selected="@(student.Id == Model.NewResult.StudentId)">
                            @student.StudentNumber · @student.FullName
                        </option>
                    }
                </select>
            </div>
            <div class="align-self-end">
                <button class="btn btn-outline-primary" type="submit">Load registered courses</button>
            </div>
        </form>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.NewResult.StudentId > 0 && Model.Courses.Count == 0)
    {
        <p class="muted-copy">This student has no confirmed course registrations for the current term.</p>
    }
    else if (Model.Courses.Count > 0)
    {
        var selectedStudent = Model.Students.SingleOrDefault(student => student.Id == Model.NewResult.StudentId);
        <form method="post" asp-page-handler="Record" class="form-grid">
            <input asp-for="NewResult.StudentId" type="hidden" />
            <input name="Search" value="@Model.Search" type="hidden" />
            <input name="ProgrammeId" value="@Model.ProgrammeId" type="hidden" />
            <input name="YearOfStudy" value="@Model.YearOfStudy" type="hidden" />
            <p class="form-grid-full mb-0">Entering a result for <strong>@selectedStudent?.FullName</strong></p>
            <div>
                <label asp-for="NewResult.CourseId" class="form-label">Registered course</label>
                <select asp-for="NewResult.CourseId" class="form-select" required>
                    <option value="">Choose course</option>
                    @foreach (var course in Model.Courses)
                    {
                        <option value="@course.Id">@course.Code · @course.Title</option>
                    }
                </select>
                <span asp-validation-for="NewResult.CourseId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="NewResult.Mark" class="form-label">Mark (%)</label>
                <input asp-for="NewResult.Mark" class="form-control" type="number" min="0" max="100" step="0.1" required />
                <span asp-validation-for="NewResult.Mark" class="text-danger"></span>
            </div>
            <div class="form-grid-full"><button class="btn btn-primary" type="submit">Save unpublished result</button></div>
        </form>
    }
</section>

<section class="card-surface">
    <div class="card-heading">
        <div><p class="section-kicker">Pending publication</p><h2>@Model.PendingGroups.Count student batch(es)</h2></div>
    </div>
    @if (Model.PendingGroups.Count == 0)
    {
        <p class="muted-copy">No unpublished result batches exist.</p>
    }
    else
    {
        @foreach (var group in Model.PendingGroups)
        {
            <article class="result-batch">
                <div>
                    <strong>@group.StudentNumber · @group.StudentName</strong>
                    <span>@string.Join(", ", group.Results.Select(result => $"{result.CourseCode}: {result.Mark:N1}% ({result.Grade})"))</span>
                </div>
                <form method="post" asp-page-handler="Publish">
                    <input type="hidden" name="studentId" value="@group.StudentId" />
                    <button class="btn btn-primary" type="submit">Publish batch</button>
                </form>
            </article>
        }
    }
</section>

<section class="card-surface">
    <p class="section-kicker">Published this period</p>
    <h2>@Model.PublishedResults.Count result(s)</h2>
    @if (Model.PublishedResults.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Student</th><th>Course</th><th>Mark</th><th>Grade</th><th>Published</th></tr></thead>
                <tbody>
                    @foreach (var result in Model.PublishedResults)
                    {
                        <tr>
                            <td>@result.Student.StudentNumber · @result.Student.FullName</td>
                            <td>@result.CourseCode</td>
                            <td>@result.Mark.ToString("N1")%</td>
                            <td>@result.Grade</td>
                            <td>@result.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
