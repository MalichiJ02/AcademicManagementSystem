@page
@model AcademicManagementSystem.Web.Pages.Admin.CourseImportModel
@{
    ViewData["Title"] = "Import courses";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1>Import courses from CSV</h1>
        <p>Import many courses and their prerequisite relationships at once.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Academic">Back to academic setup</a>
</section>

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Step 1</p>
            <h2>Prepare your CSV file</h2>
        </div>
    </div>

    <p class="muted-copy">
        The programme and study mode must already exist. Leave
        PrerequisiteCourseCode blank when the course has no prerequisite.
    </p>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>CourseCode</th>
                    <th>CourseTitle</th>
                    <th>ProgrammeCode</th>
                    <th>StudyMode</th>
                    <th>YearLevel</th>
                    <th>CreditUnits</th>
                    <th>SemesterOffered</th>
                    <th>ExpectedEnrollment</th>
                    <th>CourseType</th>
                    <th>PrerequisiteCourseCode</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CS220</td>
                    <td>Data Structures and Algorithms</td>
                    <td>CS</td>
                    <td>Full-time</td>
                    <td>2</td>
                    <td>4</td>
                    <td>Semester 2</td>
                    <td>40</td>
                    <td>Core</td>
                    <td>CS120</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Step 2</p>
            <h2>Upload and import</h2>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div>
            <label asp-for="CsvFile" class="form-label">CSV file</label>
            <input asp-for="CsvFile" class="form-control" accept=".csv,text/csv" />
        </div>

        <button class="btn btn-primary" type="submit">Import courses</button>
    </form>
</section>

@if (Model.ImportResults.Count > 0)
{
    <section class="card-surface registration-summary">
        <div class="card-heading">
            <div>
                <p class="section-kicker">Import results</p>
                <h2>@Model.SuccessfulImports imported · @Model.FailedImports failed</h2>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Line</th>
                        <th>Course code</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.ImportResults)
                    {
                        <tr>
                            <td>@result.LineNumber</td>
                            <td>@result.CourseCode</td>
                            <td>
                                <span class="status-pill @(result.Success ? "status-success" : "status-danger")">
                                    @(result.Success ? "Imported" : "Failed")
                                </span>
                            </td>
                            <td>@result.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}