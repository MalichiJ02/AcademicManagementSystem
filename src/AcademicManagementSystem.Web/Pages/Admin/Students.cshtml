@page
@model AcademicManagementSystem.Web.Pages.Admin.StudentsModel
@{
    ViewData["Title"] = "Students";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1>Students and accounts</h1>
        <p>Create each student record once, then give that student their own secure login.</p>
    </div>
</section>

@if (Model.EditId.HasValue)
{
    <section class="card-surface form-card">
        <div class="card-heading">
            <div>
                <p class="section-kicker">Edit student</p>
                <h2>@Model.UpdateStudent.FirstName @Model.UpdateStudent.LastName</h2>
            </div>
            <a class="btn btn-outline-primary" asp-page="/Admin/Students">Cancel</a>
        </div>
        <form method="post" asp-page-handler="Update" class="form-grid">
            <input asp-for="UpdateStudent.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger form-grid-full"></div>
            <div>
                <label asp-for="UpdateStudent.StudentNumber" class="form-label">Student number</label>
                <input asp-for="UpdateStudent.StudentNumber" class="form-control" />
            </div>
            <div>
                <label asp-for="UpdateStudent.YearOfStudy" class="form-label">Year of study</label>
                <input asp-for="UpdateStudent.YearOfStudy" class="form-control" type="number" min="1" max="8" />
            </div>
            <div>
                <label asp-for="UpdateStudent.FirstName" class="form-label">First name</label>
                <input asp-for="UpdateStudent.FirstName" class="form-control" />
            </div>
            <div>
                <label asp-for="UpdateStudent.LastName" class="form-label">Last name</label>
                <input asp-for="UpdateStudent.LastName" class="form-control" />
            </div>
            <div>
                <label asp-for="UpdateStudent.ProgrammeId" class="form-label">Programme</label>
                <select asp-for="UpdateStudent.ProgrammeId" class="form-select">
                    @foreach (var programme in Model.Programmes)
                    {
                        <option value="@programme.Id">@programme.Code · @programme.Name</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="UpdateStudent.StudyModeId" class="form-label">Study mode</label>
                <select asp-for="UpdateStudent.StudyModeId" class="form-select">
                    @foreach (var studyMode in Model.StudyModes)
                    {
                        <option value="@studyMode.Id">@studyMode.Name</option>
                    }
                </select>
            </div>
            <div class="form-check form-grid-full">
                <input asp-for="UpdateStudent.IsAcademicallyEligible" class="form-check-input" />
                <label asp-for="UpdateStudent.IsAcademicallyEligible" class="form-check-label">Academically eligible</label>
            </div>
            <div class="form-grid-full">
                <label asp-for="UpdateStudent.AcademicHoldReason" class="form-label">Academic hold reason</label>
                <input asp-for="UpdateStudent.AcademicHoldReason" class="form-control" />
            </div>
            <div class="form-check form-grid-full">
                <input asp-for="UpdateStudent.IsActive" class="form-check-input" />
                <label asp-for="UpdateStudent.IsActive" class="form-check-label">Student account is active</label>
            </div>
            <div class="form-grid-full">
                <button class="btn btn-primary" type="submit">Save student changes</button>
            </div>
        </form>
    </section>
}
else
{
    <section class="card-surface form-card">
        <p class="section-kicker">New student</p>
        <h2>Create a student record and secure account</h2>
        @if (Model.Programmes.Count == 0 || Model.StudyModes.Count == 0)
        {
            <p class="alert alert-warning mb-0">
                Add at least one programme and one study mode in
                <a asp-page="/Admin/Academic">Academic setup</a> before creating student accounts.
            </p>
        }
        else
        {
            <form method="post" asp-page-handler="Create" class="form-grid">
                <div asp-validation-summary="ModelOnly" class="text-danger form-grid-full"></div>
                <div>
                    <label asp-for="NewStudent.StudentNumber" class="form-label">Student number</label>
                    <input asp-for="NewStudent.StudentNumber" class="form-control" placeholder="e.g. 2023123456" />
                </div>
                <div>
                    <label asp-for="NewStudent.YearOfStudy" class="form-label">Year of study</label>
                    <input asp-for="NewStudent.YearOfStudy" class="form-control" type="number" min="1" max="8" />
                </div>
                <div>
                    <label asp-for="NewStudent.FirstName" class="form-label">First name</label>
                    <input asp-for="NewStudent.FirstName" class="form-control" />
                </div>
                <div>
                    <label asp-for="NewStudent.LastName" class="form-label">Last name</label>
                    <input asp-for="NewStudent.LastName" class="form-control" />
                </div>
                <div>
                    <label asp-for="NewStudent.ProgrammeId" class="form-label">Programme</label>
                    <select asp-for="NewStudent.ProgrammeId" class="form-select">
                        <option value="0">Choose programme</option>
                        @foreach (var programme in Model.Programmes.Where(item => item.IsActive))
                        {
                            <option value="@programme.Id">@programme.Code · @programme.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="NewStudent.StudyModeId" class="form-label">Study mode</label>
                    <select asp-for="NewStudent.StudyModeId" class="form-select">
                        <option value="0">Choose study mode</option>
                        @foreach (var studyMode in Model.StudyModes.Where(item => item.IsActive))
                        {
                            <option value="@studyMode.Id">@studyMode.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label asp-for="NewStudent.Email" class="form-label">Student email / username</label>
                    <input asp-for="NewStudent.Email" class="form-control" type="email" />
                </div>
                <div>
                    <label asp-for="NewStudent.InitialPassword" class="form-label">Initial password</label>
                    <input asp-for="NewStudent.InitialPassword" class="form-control" type="password" autocomplete="new-password" />
                </div>
                <div class="form-grid-full">
                    <button class="btn btn-primary" type="submit">Create student account</button>
                </div>
            </form>
        }
    </section>
}

<section class="card-surface">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Student records</p>
            <h2>@Model.Students.Count student(s)</h2>
        </div>
    </div>
    @if (Model.Students.Count == 0)
    {
        <p class="muted-copy">No student records exist yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Programme / mode</th>
                        <th>Year</th>
                        <th>Academic status</th>
                        <th>Account</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td><strong>@student.StudentNumber</strong><br /><span class="muted-copy">@student.FullName</span></td>
                            <td>@student.Programme<br /><span class="muted-copy">@student.StudyMode</span></td>
                            <td>@student.YearOfStudy</td>
                            <td>
                                <span class="status-pill @(student.IsAcademicallyEligible ? "status-success" : "status-danger")">
                                    @(student.IsAcademicallyEligible ? "Eligible" : "Hold")
                                </span>
                            </td>
                            <td>
                                <span class="status-pill @(student.IsActive ? "status-success" : "status-muted")">
                                    @(student.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Students" asp-route-editId="@student.Id">Manage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
