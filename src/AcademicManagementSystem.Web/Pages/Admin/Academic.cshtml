@page
@model AcademicManagementSystem.Web.Pages.Admin.AcademicModel
@{
    ViewData["Title"] = "Academic setup";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1>Academic setup and rules</h1>
        <p>Configure the exact information used for invoices, eligibility, course selection, and timetable generation.</p>
    </div>
</section>
<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Bulk import tools</p>
            <h2>Set up system data from CSV files</h2>
        </div>
        <span class="status-pill status-info">Recommended for initial setup</span>
    </div>

    <p class="muted-copy">
        Use these import tools to add many records at once. Study modes remain
        manual because there are normally only three: Full-time, Part-time, and Evening.
    </p>

    <div class="dashboard-grid">
        <a class="card-surface action-card" asp-page="/Admin/ProgrammeImport">
            <p class="section-kicker">Step 1</p>
            <h3>Import programmes</h3>
            <p class="muted-copy">Add programme codes, names, and tuition amounts.</p>
        </a>

        <a class="card-surface action-card" asp-page="/Admin/CourseImport">
            <p class="section-kicker">Step 2</p>
            <h3>Import courses</h3>
            <p class="muted-copy">Add courses after programmes and study modes exist.</p>
        </a>

        <a class="card-surface action-card" asp-page="/Admin/LecturerImport">
            <p class="section-kicker">Step 3</p>
            <h3>Import lecturers</h3>
            <p class="muted-copy">Add staff numbers, names, specialisations, and available days.</p>
        </a>

        <a class="card-surface action-card" asp-page="/Admin/RoomImport">
            <p class="section-kicker">Step 4</p>
            <h3>Import rooms</h3>
            <p class="muted-copy">Add lecture theatres, classrooms, labs, and capacities.</p>
        </a>

        <a class="card-surface action-card" asp-page="/Admin/CourseLecturerAssignments">
            <p class="section-kicker">Step 5</p>
            <h3>Assign lecturers to courses</h3>
            <p class="muted-copy">Choose which lecturers may teach each course.</p>
        </a>

        <a class="card-surface action-card" asp-page="/Admin/StudentImport">
            <p class="section-kicker">Step 6</p>
            <h3>Import students</h3>
            <p class="muted-copy">Create student records and Student-ID login accounts.</p>
        </a>
    </div>
</section>

<section class="card-surface form-card">
    <p class="section-kicker">1 · Academic and financial rules</p>
    <h2>Current period and access requirements</h2>
    <form method="post" asp-page-handler="SaveSettings" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="text-danger form-grid-full"></div>
        <div>
            <label asp-for="SettingsInput.AcademicYear" class="form-label">Academic year</label>
            <input asp-for="SettingsInput.AcademicYear" class="form-control" placeholder="e.g. 2026" />
        </div>
        <div>
            <label asp-for="SettingsInput.Semester" class="form-label">Semester</label>
            <select asp-for="SettingsInput.Semester" class="form-select">
                <option>Semester 1</option>
                <option>Semester 2</option>
            </select>
        </div>
        <div>
            <label asp-for="SettingsInput.RegistrationPaymentPercentage" class="form-label">Registration payment %</label>
            <input asp-for="SettingsInput.RegistrationPaymentPercentage" class="form-control" type="number" min="0" max="100" step="0.01" />
        </div>
        <div>
            <label asp-for="SettingsInput.ExamSlipPaymentPercentage" class="form-label">Exam slip payment %</label>
            <input asp-for="SettingsInput.ExamSlipPaymentPercentage" class="form-control" type="number" min="0" max="100" step="0.01" />
        </div>
        <div>
            <label asp-for="SettingsInput.ResultsPaymentPercentage" class="form-label">Results payment %</label>
            <input asp-for="SettingsInput.ResultsPaymentPercentage" class="form-control" type="number" min="0" max="100" step="0.01" />
        </div>
        <div>
            <label asp-for="SettingsInput.LateRegistrationFee" class="form-label">Late-registration fee (ZMW)</label>
            <input asp-for="SettingsInput.LateRegistrationFee" class="form-control" type="number" min="0" step="0.01" />
        </div>
        <div>
            <label asp-for="SettingsInput.MaximumTotalCourses" class="form-label">Maximum total courses</label>
            <input asp-for="SettingsInput.MaximumTotalCourses" class="form-control" type="number" min="1" max="4" />
        </div>
        <div>
            <label asp-for="SettingsInput.MaximumCarryCourses" class="form-label">Maximum carry courses (normal processing)</label>
            <input asp-for="SettingsInput.MaximumCarryCourses" class="form-control" type="number" min="0" max="4" />
        </div>
        <div>
            <label asp-for="SettingsInput.FailedCoursesForRestriction" class="form-label">Failed courses before restriction</label>
            <input asp-for="SettingsInput.FailedCoursesForRestriction" class="form-control" type="number" min="0" max="10" />
        </div>
        <div class="check-stack">
            <div class="form-check">
                <input asp-for="SettingsInput.IsRegistrationOpen" class="form-check-input" />
                <label asp-for="SettingsInput.IsRegistrationOpen" class="form-check-label">Registration is open</label>
            </div>
            <div class="form-check">
                <input asp-for="SettingsInput.IsLateRegistrationOpen" class="form-check-input" />
                <label asp-for="SettingsInput.IsLateRegistrationOpen" class="form-check-label">Late registration period is active</label>
            </div>
        </div>
        <div class="form-grid-full">
            <button class="btn btn-primary" type="submit">Save academic rules</button>
        </div>
    </form>
</section>

<section class="split-grid">
    <article class="card-surface form-card">
        <p class="section-kicker">2 · Programmes</p>
        <h2>Add programme</h2>
        <form method="post" asp-page-handler="AddProgramme" class="stack-form">
            <div>
                <label asp-for="NewProgramme.Code" class="form-label">Programme code</label>
                <input asp-for="NewProgramme.Code" class="form-control" placeholder="e.g. BSC-CS" />
            </div>
            <div>
                <label asp-for="NewProgramme.Name" class="form-label">Programme name</label>
                <input asp-for="NewProgramme.Name" class="form-control" placeholder="e.g. BSc Computer Science" />
            </div>
            <div>
                <label asp-for="NewProgramme.TuitionAmount" class="form-label">Base tuition (ZMW)</label>
                <input asp-for="NewProgramme.TuitionAmount" class="form-control" type="number" min="0" step="0.01" />
            </div>
            <button class="btn btn-primary" type="submit">Add programme</button>
        </form>
        <hr />
        @if (Model.Programmes.Count == 0)
        {
            <p class="muted-copy">No programmes have been added.</p>
        }
        else
        {
            @foreach (var programme in Model.Programmes)
            {
                <form method="post" asp-page-handler="UpdateProgramme" class="form-grid admin-edit-form">
                    <input type="hidden" name="programmeId" value="@programme.Id" />
                    <div>
                        <label class="form-label">Programme code</label>
                        <input class="form-control" value="@programme.Code" disabled />
                    </div>
                    <div>
                        <label class="form-label">Programme name</label>
                        <input class="form-control" name="name" value="@programme.Name" />
                    </div>
                    <div>
                        <label class="form-label">Base tuition (ZMW)</label>
                        <input class="form-control" name="tuitionAmount" type="number" min="0" step="0.01" value="@programme.TuitionAmount" />
                    </div>
                    <div class="check-stack">
                        <input type="hidden" name="isActive" value="false" />
                        <label class="form-check-label"><input class="form-check-input" name="isActive" type="checkbox" value="true" checked="@programme.IsActive" /> Active</label>
                        <button class="btn btn-sm btn-outline-primary" type="submit">Save programme</button>
                    </div>
                </form>
            }
        }
    </article>

    <article class="card-surface form-card">
        <p class="section-kicker">3 · Study modes and payment accounts</p>
        <h2>Add study mode</h2>
        <p class="muted-copy">Create Full-time, Part-time, and Evening as separate modes. Part-time should normally use a 1–2 course limit.</p>
        <form method="post" asp-page-handler="AddStudyMode" class="stack-form">
            <div>
                <label asp-for="NewStudyMode.Name" class="form-label">Study mode</label>
                <input asp-for="NewStudyMode.Name" class="form-control" placeholder="Full-time, Part-time, or Evening" />
            </div>
            <div>
                <label asp-for="NewStudyMode.Description" class="form-label">Description</label>
                <input asp-for="NewStudyMode.Description" class="form-control" placeholder="How this mode is delivered" />
            </div>
            <div class="form-grid">
                <div>
                    <label asp-for="NewStudyMode.MaximumCourses" class="form-label">Maximum courses</label>
                    <input asp-for="NewStudyMode.MaximumCourses" class="form-control" type="number" min="1" max="4" />
                </div>
                <div>
                    <label asp-for="NewStudyMode.AdditionalFee" class="form-label">Mode fee (ZMW)</label>
                    <input asp-for="NewStudyMode.AdditionalFee" class="form-control" type="number" min="0" step="0.01" />
                </div>
            </div>
            <div>
                <label asp-for="NewStudyMode.PaymentAccountName" class="form-label">Payment account name</label>
                <input asp-for="NewStudyMode.PaymentAccountName" class="form-control" placeholder="e.g. CBU Full-time Fees" />
            </div>
            <div>
                <label asp-for="NewStudyMode.PaymentAccountReference" class="form-label">Payment account / reference</label>
                <input asp-for="NewStudyMode.PaymentAccountReference" class="form-control" placeholder="e.g. FT-2026" />
            </div>
            <button class="btn btn-primary" type="submit">Add study mode</button>
        </form>
        <hr />
        @if (Model.StudyModes.Count == 0)
        {
            <p class="muted-copy">No study modes have been added.</p>
        }
        else
        {
            @foreach (var studyMode in Model.StudyModes)
            {
                <form method="post" asp-page-handler="UpdateStudyMode" class="form-grid admin-edit-form">
                    <input type="hidden" name="studyModeId" value="@studyMode.Id" />
                    <div>
                        <label class="form-label">Study mode</label>
                        <input class="form-control" value="@studyMode.Name" disabled />
                    </div>
                    <div>
                        <label class="form-label">Description</label>
                        <input class="form-control" name="description" value="@studyMode.Description" />
                    </div>
                    <div>
                        <label class="form-label">Maximum courses</label>
                        <input class="form-control" name="maximumCourses" type="number" min="1" max="4" value="@studyMode.MaximumCourses" />
                    </div>
                    <div>
                        <label class="form-label">Mode fee (ZMW)</label>
                        <input class="form-control" name="additionalFee" type="number" min="0" step="0.01" value="@studyMode.AdditionalFee" />
                    </div>
                    <div>
                        <label class="form-label">Payment account name</label>
                        <input class="form-control" name="paymentAccountName" value="@studyMode.PaymentAccountName" />
                    </div>
                    <div>
                        <label class="form-label">Payment account / reference</label>
                        <input class="form-control" name="paymentAccountReference" value="@studyMode.PaymentAccountReference" />
                    </div>
                    <div class="check-stack form-grid-full">
                        <input type="hidden" name="isActive" value="false" />
                        <label class="form-check-label"><input class="form-check-input" name="isActive" type="checkbox" value="true" checked="@studyMode.IsActive" /> Active</label>
                        <div><button class="btn btn-sm btn-outline-primary" type="submit">Save study mode</button></div>
                    </div>
                </form>
            }
        }
    </article>
</section>

<section class="card-surface form-card">
    <p class="section-kicker">4 · Courses and prerequisites</p>
    <h2>Add a course</h2>
    @if (Model.Programmes.Count == 0)
    {
        <p class="alert alert-warning mb-0">Add a programme first.</p>
    }
    else
    {
        <form method="post" asp-page-handler="AddCourse" class="form-grid">
            <div>
                <label asp-for="NewCourse.Code" class="form-label">Course code</label>
                <input asp-for="NewCourse.Code" class="form-control" placeholder="e.g. CS301" />
            </div>
            <div>
                <label asp-for="NewCourse.Title" class="form-label">Course title</label>
                <input asp-for="NewCourse.Title" class="form-control" />
            </div>
            <div>
                <label asp-for="NewCourse.ProgrammeId" class="form-label">Programme</label>
                <select asp-for="NewCourse.ProgrammeId" class="form-select">
                    <option value="0">Choose programme</option>
                    @foreach (var programme in Model.Programmes.Where(item => item.IsActive))
                    {
                        <option value="@programme.Id">@programme.Code · @programme.Name</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="NewCourse.StudyModeId" class="form-label">Study mode</label>
                <select asp-for="NewCourse.StudyModeId" class="form-select">
                    <option value="0">All programme study modes</option>
                    @foreach (var studyMode in Model.StudyModes.Where(item => item.IsActive))
                    {
                        <option value="@studyMode.Id">@studyMode.Name only</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="NewCourse.YearLevel" class="form-label">Year level</label>
                <input asp-for="NewCourse.YearLevel" class="form-control" type="number" min="1" max="8" />
            </div>
            <div>
                <label asp-for="NewCourse.CreditUnits" class="form-label">Credit units</label>
                <input asp-for="NewCourse.CreditUnits" class="form-control" type="number" min="1" max="30" />
            </div>
            <div>
                <label asp-for="NewCourse.SemesterOffered" class="form-label">Semester offered</label>
                <select asp-for="NewCourse.SemesterOffered" class="form-select">
                    <option>Semester 1</option>
                    <option>Semester 2</option>
                    <option>Both</option>
                </select>
            </div>
            <div>
                <label asp-for="NewCourse.ExpectedEnrollment" class="form-label">Expected enrolment</label>
                <input asp-for="NewCourse.ExpectedEnrollment" class="form-control" type="number" min="1" />
            </div>
            <div>
                <label asp-for="NewCourse.CourseType" class="form-label">Course type</label>
                <select asp-for="NewCourse.CourseType" class="form-select">
                    <option>Core</option>
                    <option>Elective</option>
                    <option>Carry eligible</option>
                </select>
            </div>
            <div class="form-grid-full">
                <button class="btn btn-primary" type="submit">Add course</button>
            </div>
        </form>
    }

    <hr />
    @if (Model.Courses.Count == 0)
    {
        <p class="muted-copy">No courses have been added.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Course</th><th>Programme / mode</th><th>Level</th><th>Offered</th><th>Expected</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var course in Model.Courses)
                    {
                        <tr>
                            <td><strong>@course.Code</strong><br /><span class="muted-copy">@course.Title</span></td>
                            <td>@course.Programme?.Code<br /><span class="muted-copy">@(course.StudyMode?.Name ?? "All modes")</span></td>
                            <td>Year @course.YearLevel · @course.CreditUnits CU</td>
                            <td>@course.SemesterOffered</td>
                            <td>@course.ExpectedEnrollment</td>
                            <td><span class="status-pill @(course.IsActive ? "status-success" : "status-muted")">@(course.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <form method="post" asp-page-handler="ToggleCourse">
                                    <input type="hidden" name="courseId" value="@course.Id" />
                                    <input type="hidden" name="isActive" value="@(!course.IsActive)" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit">@(course.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="subsection">
            <h3>Define prerequisites</h3>
            <form method="post" asp-page-handler="AddPrerequisite" class="inline-form">
                <select asp-for="NewPrerequisite.CourseId" class="form-select">
                    <option value="0">Course requiring a pass</option>
                    @foreach (var course in Model.Courses.Where(item => item.IsActive))
                    {
                        <option value="@course.Id">@course.Code · @course.Title</option>
                    }
                </select>
                <select asp-for="NewPrerequisite.PrerequisiteCourseId" class="form-select">
                    <option value="0">Required passed course</option>
                    @foreach (var course in Model.Courses.Where(item => item.IsActive))
                    {
                        <option value="@course.Id">@course.Code · @course.Title</option>
                    }
                </select>
                <button class="btn btn-primary" type="submit">Add prerequisite</button>
            </form>
            @if (Model.Prerequisites.Count > 0)
            {
                <ul class="tag-list">
                    @foreach (var prerequisite in Model.Prerequisites)
                    {
                        <li>
                            <strong>@prerequisite.Course.Code</strong> requires <strong>@prerequisite.PrerequisiteCourse.Code</strong>
                            <form method="post" asp-page-handler="RemovePrerequisite">
                                <input type="hidden" name="courseId" value="@prerequisite.CourseId" />
                                <input type="hidden" name="prerequisiteCourseId" value="@prerequisite.PrerequisiteCourseId" />
                                <button class="link-danger" type="submit">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>

<section class="split-grid">
    <article class="card-surface form-card">
        <p class="section-kicker">5 · Lecturers</p>
        <h2>Add lecturer availability</h2>
        <form method="post" asp-page-handler="AddLecturer" class="stack-form">
            <div><label asp-for="NewLecturer.StaffNumber" class="form-label">Staff number</label><input asp-for="NewLecturer.StaffNumber" class="form-control" /></div>
            <div><label asp-for="NewLecturer.FullName" class="form-label">Full name</label><input asp-for="NewLecturer.FullName" class="form-control" /></div>
            <div><label asp-for="NewLecturer.Specialisation" class="form-label">Specialisation</label><input asp-for="NewLecturer.Specialisation" class="form-control" /></div>
            <div><label asp-for="NewLecturer.AvailableDays" class="form-label">Available days</label><input asp-for="NewLecturer.AvailableDays" class="form-control" placeholder="Monday|Wednesday|Friday" /></div>
            <button class="btn btn-primary" type="submit">Add lecturer</button>
        </form>
        @if (Model.Lecturers.Count > 0)
        {
            <ul class="plain-list">
                @foreach (var lecturer in Model.Lecturers)
                {
                    <li><strong>@lecturer.StaffNumber</strong> · @lecturer.FullName<br /><span class="muted-copy">@lecturer.AvailableDays</span></li>
                }
            </ul>
        }
    </article>
    <article class="card-surface form-card">
        <p class="section-kicker">6 · Rooms</p>
        <h2>Add teaching room</h2>
        <form method="post" asp-page-handler="AddRoom" class="stack-form">
            <div><label asp-for="NewRoom.Code" class="form-label">Room code</label><input asp-for="NewRoom.Code" class="form-control" /></div>
            <div><label asp-for="NewRoom.Name" class="form-label">Room name</label><input asp-for="NewRoom.Name" class="form-control" /></div>
            <div class="form-grid">
                <div><label asp-for="NewRoom.Capacity" class="form-label">Capacity</label><input asp-for="NewRoom.Capacity" class="form-control" type="number" min="1" /></div>
                <div><label asp-for="NewRoom.RoomType" class="form-label">Room type</label><input asp-for="NewRoom.RoomType" class="form-control" placeholder="Lecture room or lab" /></div>
            </div>
            <button class="btn btn-primary" type="submit">Add room</button>
        </form>
        @if (Model.Rooms.Count > 0)
        {
            <ul class="plain-list">
                @foreach (var room in Model.Rooms)
                {
                    <li><strong>@room.Code</strong> · @room.Name<br /><span class="muted-copy">@room.RoomType · capacity @room.Capacity</span></li>
                }
            </ul>
        }
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
