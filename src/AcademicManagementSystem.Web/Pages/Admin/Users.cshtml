@page
@model AcademicManagementSystem.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Staff accounts";
    var groups = Model.Users.GroupBy(account =>
    {
        var roles = account.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (roles.Contains("Administrator", StringComparer.OrdinalIgnoreCase)) return "Administrators";
        if (roles.Contains("Coordinator", StringComparer.OrdinalIgnoreCase)) return "Coordinators";
        if (roles.Contains("Student", StringComparer.OrdinalIgnoreCase) || account.StudentId.HasValue) return "Student accounts";
        return "Other accounts";
    }).ToDictionary(group => group.Key);
    var groupOrder = new[] { "Administrators", "Coordinators", "Student accounts", "Other accounts" };
}

<header class="page-heading">
    <div><h1>Staff accounts</h1></div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Students">Student directory</a>
</header>

<details class="card-surface directory-panel directory-add" open="@(ViewData.ModelState.ErrorCount > 0)">
    <summary>Add staff account</summary>
    <form method="post" asp-page-handler="Create" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="text-danger form-grid-full"></div>

        <div>
            <label asp-for="NewAccount.FullName" class="form-label">Full name</label>
            <input asp-for="NewAccount.FullName" class="form-control" />
        </div>

        <div>
            <label asp-for="NewAccount.Email" class="form-label">Email / username</label>
            <input asp-for="NewAccount.Email"
                   class="form-control"
                   type="email" />
        </div>

        <div>
            <label asp-for="NewAccount.Password" class="form-label">Initial password</label>
            <input asp-for="NewAccount.Password"
                   class="form-control"
                   type="password"
                   autocomplete="new-password" />
        </div>

        <div>
            <label asp-for="NewAccount.Role" class="form-label">Role</label>
            <select asp-for="NewAccount.Role" class="form-select">
                <option>Coordinator</option>
                <option>Administrator</option>
            </select>
        </div>

        <div>
            <label asp-for="NewAccount.CoordinatingSchoolId" class="form-label">
                Coordinator school
            </label>
            <select asp-for="NewAccount.CoordinatingSchoolId" class="form-select">
                <option value="0">Choose school for coordinator</option>
                @foreach (var school in Model.Schools)
                {
                    <option value="@school.Id">@school.Code · @school.Name</option>
                }
            </select>
            <small class="muted-copy">
                Required for a Coordinator. Administrators manage all schools.
            </small>
        </div>

        <div class="form-grid-full">
            <button class="btn btn-primary" type="submit">Create staff account</button>
        </div>
    </form>
</details>

<section class="card-surface directory-panel">
    <h2>Account directory</h2>
    @if (Model.Users.Count == 0)
    {
        <p>No accounts found.</p>
    }
    @foreach (var groupName in groupOrder)
    {
        if (!groups.TryGetValue(groupName, out var accounts))
        {
            continue;
        }
        <details class="academic-programme">
            <summary><strong>@groupName</strong> <span>@accounts.Count() accounts</span></summary>
            <div class="table-responsive mt-2">
                <table class="table table-hover align-middle directory-table">
                    <thead>
                        <tr>
                            <th scope="col">Name / email</th>
                            <th scope="col">Role</th>
                            <th scope="col">School</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in accounts)
                        {
                            var canAssignSchool = account.Roles.Split(',', StringSplitOptions.TrimEntries)
                                .Contains("Coordinator", StringComparer.OrdinalIgnoreCase);
                            <tr>
                                <td><strong>@account.FullName</strong><br /><span class="muted-copy">@account.Email</span></td>
                                <td>@account.Roles</td>
                                <td>
                                    @if (canAssignSchool)
                                    {
                                        @(account.CoordinatingSchoolName ?? "Unassigned")
                                        <details class="mt-1">
                                            <summary>Change school</summary>
                                <form method="post"
                                      asp-page-handler="AssignCoordinatorSchool"
                                      class="stack-form">
                                    <input type="hidden" name="userId" value="@account.Id" />

                                    <select name="coordinatingSchoolId" class="form-select" aria-label="Coordinator school for @account.FullName">
                                        <option value="">Not assigned</option>

                                        @foreach (var school in Model.Schools)
                                        {
                                            if (account.CoordinatingSchoolId == school.Id)
                                            {
                                                <option value="@school.Id" selected>
                                                    @school.Code · @school.Name
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@school.Id">
                                                    @school.Code · @school.Name
                                                </option>
                                            }
                                        }
                                    </select>

                                    <button class="btn btn-sm btn-outline-primary" type="submit">
                                        Save
                                    </button>
                                </form>
                                        </details>
                                    }
                                    else
                                    {
                                        @(groupName == "Administrators" ? "All schools" : "—")
                                    }
                                </td>
                                <td><span class="status-pill @(account.IsActive ? "status-success" : "status-muted")">@(account.IsActive ? "Active" : "Disabled")</span></td>
                                <td>
                            <form method="post" asp-page-handler="ToggleActive">
                                <input type="hidden" name="userId" value="@account.Id" />
                                <input type="hidden" name="isActive" value="@(!account.IsActive)" />

                                <button class="btn btn-sm btn-outline-primary" type="submit">
                                    @(account.IsActive ? "Disable" : "Enable")
                                </button>
                            </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</section>
