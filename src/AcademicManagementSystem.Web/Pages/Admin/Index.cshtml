@page
@model AcademicManagementSystem.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
}

<header class="page-heading admin-heading">
    <div>
        <p class="term-label">@Model.Settings.AcademicYear · @Model.Settings.Semester</p>
        <h1>Administration</h1>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Academic">Academic setup</a>
</header>

<section class="admin-workboard" aria-labelledby="admin-actions-title">
    <h2 id="admin-actions-title">Quick actions</h2>
    <ul class="admin-action-list">
        <li><a asp-page="/Admin/Students">Find a student</a></li>
        <li><a asp-page="/Coordinator/Timetable">Review the timetable</a></li>
        <li><a asp-page="/Admin/Users">Manage staff accounts</a></li>
        <li><a asp-page="/Coordinator/Results">Enter or publish results</a></li>
        <li><a asp-page="/Admin/Finance">Record a payment</a></li>
        <li><a asp-page="/Admin/StudentImport">Import students</a></li>
    </ul>
</section>

<section class="admin-overview" aria-labelledby="admin-records-title">
    <h2 id="admin-records-title">Records</h2>
    <dl class="admin-records">
        <div><dt>Students</dt><dd>@Model.StudentCount.ToString("N0")</dd></div>
        <div><dt>Programmes</dt><dd>@Model.ProgrammeCount.ToString("N0")</dd></div>
        <div><dt>Courses</dt><dd>@Model.CourseCount.ToString("N0")</dd></div>
        <div><dt>Study modes</dt><dd>@Model.StudyModeCount.ToString("N0")</dd></div>
        <div><dt>Invoices</dt><dd>@Model.InvoiceCount.ToString("N0")</dd></div>
        <div><dt>Timetable sessions</dt><dd>@Model.TimetableEntryCount.ToString("N0")</dd></div>
    </dl>
</section>

<section class="card-surface admin-rules" aria-labelledby="admin-rules-title">
    <div class="card-heading">
        <h2 id="admin-rules-title">Payment thresholds</h2>
        <a asp-page="/Admin/Academic" asp-route-section="rules">Edit rules</a>
    </div>
    <dl class="admin-records">
        <div><dt>Registration</dt><dd>@(Model.Settings.RegistrationPaymentPercentage.ToString("N0"))%</dd></div>
        <div><dt>Exam slip</dt><dd>@(Model.Settings.ExamSlipPaymentPercentage.ToString("N0"))%</dd></div>
        <div><dt>Results</dt><dd>@(Model.Settings.ResultsPaymentPercentage.ToString("N0"))%</dd></div>
    </dl>
    <p class="muted-copy mb-0">Course limit: @Model.Settings.MaximumTotalCourses, including up to @Model.Settings.MaximumCarryCourses carry courses.</p>
</section>
