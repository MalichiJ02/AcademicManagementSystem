@page
@model AcademicManagementSystem.Web.Pages.Admin.CourseLecturerAssignmentImportModel
@{
    ViewData["Title"] = "Import course lecturer assignments";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1>Import course–lecturer assignments</h1>
        <p>Assign lecturers to many courses at once before generating the timetable.</p>
    </div>

    <a class="btn btn-outline-primary" asp-page="/Admin/CourseLecturerAssignments">
        Back to assignments
    </a>
</section>

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Step 1</p>
            <h2>Prepare your CSV file</h2>
        </div>
    </div>

    <p class="muted-copy">
        Courses and lecturers must already exist. Use course codes and lecturer
        staff numbers exactly as they were imported.
    </p>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>CourseCode</th>
                    <th>LecturerStaffNumber</th>
                    <th>IsPrimary</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CS301</td>
                    <td>STAFF-001</td>
                    <td>Yes</td>
                </tr>
                <tr>
                    <td>CS350</td>
                    <td>STAFF-002</td>
                    <td>Yes</td>
                </tr>
                <tr>
                    <td>CS360</td>
                    <td>STAFF-003</td>
                    <td>No</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="muted-copy mb-0">
        Use <strong>Yes</strong> for one primary lecturer per course.
        Use <strong>No</strong> for an additional lecturer.
    </p>
</section>

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Step 2</p>
            <h2>Upload and import</h2>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div>
            <label asp-for="CsvFile" class="form-label">CSV file</label>
            <input asp-for="CsvFile" class="form-control" accept=".csv,text/csv" />
            <span asp-validation-for="CsvFile" class="text-danger"></span>
        </div>

        <button class="btn btn-primary" type="submit">
            Import assignments
        </button>
    </form>
</section>

@if (Model.ImportResults.Count > 0)
{
    <section class="card-surface registration-summary">
        <div class="card-heading">
            <div>
                <p class="section-kicker">Import results</p>
                <h2>@Model.SuccessfulImports imported · @Model.FailedImports failed</h2>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Line</th>
                        <th>Course</th>
                        <th>Lecturer staff number</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.ImportResults)
                    {
                        <tr>
                            <td>@result.LineNumber</td>
                            <td>@result.CourseCode</td>
                            <td>@result.LecturerStaffNumber</td>
                            <td>
                                <span class="status-pill @(result.Success ? "status-success" : "status-danger")">
                                    @(result.Success ? "Imported" : "Failed")
                                </span>
                            </td>
                            <td>@result.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}