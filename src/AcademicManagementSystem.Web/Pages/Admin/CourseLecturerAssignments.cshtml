@page
@model AcademicManagementSystem.Web.Pages.Admin.CourseLecturerAssignmentsModel
@{
    ViewData["Title"] = "Course lecturer assignments";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Administrator workspace</p>
        <h1>Course–Lecturer assignments</h1>
        <p>Assign the lecturers eligible to teach each course before timetable generation.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Index">Back to administration</a>
</section>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">New assignment</p>
            <h2>Assign a lecturer to a course</h2>
        </div>
    </div>

    @if (Model.Courses.Count == 0 || Model.Lecturers.Count == 0)
    {
        <p class="alert alert-warning mb-0">
            Import or add at least one active course and lecturer first.
        </p>
    }
    else
    {
        <form method="post" asp-page-handler="Add" class="coordinator-form">
            <div>
                <label asp-for="CourseId">Course</label>
                <select asp-for="CourseId" class="form-select">
                    @foreach (var course in Model.Courses)
                    {
                        <option value="@course.Id">@course.Code — @course.Title</option>
                    }
                </select>
            </div>

            <div>
                <label asp-for="LecturerId">Lecturer</label>
                <select asp-for="LecturerId" class="form-select">
                    @foreach (var lecturer in Model.Lecturers)
                    {
                        <option value="@lecturer.Id">
                            @lecturer.FullName — @lecturer.Specialisation
                        </option>
                    }
                </select>
            </div>

            <div class="form-check align-self-end">
                <input asp-for="IsPrimary" class="form-check-input" />
                <label asp-for="IsPrimary" class="form-check-label">
                    Primary lecturer
                </label>
            </div>

            <button class="btn btn-primary" type="submit">Save assignment</button>
        </form>
    }
</section>

<section class="card-surface registration-summary">
    <div class="card-heading">
        <div>
            <p class="section-kicker">Current assignments</p>
            <h2>@Model.Assignments.Count assignment(s)</h2>
        </div>
    </div>

    @if (Model.Assignments.Count == 0)
    {
        <p class="muted-copy">No course–lecturer assignments have been created yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Lecturer</th>
                        <th>Availability</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Assignments)
                    {
                        <tr>
                            <td>
                                <strong>@assignment.Course.Code</strong><br />
                                <span class="muted-copy">@assignment.Course.Title</span>
                            </td>
                            <td>@assignment.Lecturer.FullName</td>
                            <td>@assignment.Lecturer.AvailableDays.Replace("|", ", ")</td>
                            <td>
                                <span class="status-pill @(assignment.IsPrimary ? "status-success" : "status-info")">
                                    @(assignment.IsPrimary ? "Primary" : "Backup")
                                </span>
                            </td>
                            <td class="d-flex gap-2">
                                @if (!assignment.IsPrimary)
                                {
                                    <form method="post" asp-page-handler="MakePrimary">
                                        <input type="hidden" name="id" value="@assignment.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">
                                            Make primary
                                        </button>
                                    </form>
                                }

                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="id" value="@assignment.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>