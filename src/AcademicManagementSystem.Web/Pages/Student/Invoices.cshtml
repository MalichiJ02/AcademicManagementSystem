@page
@model AcademicManagementSystem.Web.Pages.StudentPortal.InvoicesModel
@{
    ViewData["Title"] = "My invoices";
}

<section class="page-heading">
    <div>
        <p class="section-kicker">Student portal</p>
        <h1>My invoices and payments</h1>
        <p>Invoices are calculated from your programme and study mode. Payment entries are recorded by an administrator in this prototype.</p>
    </div>
</section>

@if (Model.CurrentInvoice is null)
{
    <section class="card-surface empty-state">
        <p class="section-kicker">Current period</p>
        <h2>Generate your @Model.Settings.AcademicYear · @Model.Settings.Semester invoice</h2>
        @if (Model.Student?.ProgrammeRecord is null || Model.Student?.StudyModeRecord is null)
        {
            <p class="alert alert-warning mb-0">Your programme or study mode is incomplete. Contact the administrator before generating an invoice.</p>
        }
        else
        {
            <dl class="financial-details compact-details">
                <div><dt>Programme</dt><dd>@Model.Student.ProgrammeRecord.Name</dd></div>
                <div><dt>Study mode</dt><dd>@Model.Student.StudyModeRecord.Name</dd></div>
                <div><dt>Base tuition</dt><dd>ZMW @Model.Student.ProgrammeRecord.TuitionAmount.ToString("N2")</dd></div>
                <div><dt>Mode fee</dt><dd>ZMW @Model.Student.StudyModeRecord.AdditionalFee.ToString("N2")</dd></div>
                <div><dt>Payment account</dt><dd>@Model.Student.StudyModeRecord.PaymentAccountName · @Model.Student.StudyModeRecord.PaymentAccountReference</dd></div>
                <div><dt>Late fee</dt><dd>@(Model.Settings.IsLateRegistrationOpen ? $"ZMW {Model.Settings.LateRegistrationFee:N2}" : "Not active")</dd></div>
            </dl>
            <form method="post" asp-page-handler="Generate">
                <button class="btn btn-primary" type="submit">Generate my invoice</button>
            </form>
        }
    </section>
}
else
{
    <section class="dashboard-grid">
        <article class="card-surface finance-card">
            <div class="card-heading">
                <div>
                    <p class="section-kicker">Current invoice</p>
                    <h2>@Model.CurrentInvoice.InvoiceNumber</h2>
                </div>
                <span class="status-pill @(Model.CurrentInvoice.Balance == 0m ? "status-success" : "status-info")">@Model.CurrentInvoice.Status</span>
            </div>
            <div class="payment-progress"><span style="width: @Model.CurrentInvoice.PaymentPercentage%;"></span></div>
            <dl class="financial-details">
                <div><dt>Total</dt><dd>ZMW @Model.CurrentInvoice.TotalAmount.ToString("N2")</dd></div>
                <div><dt>Paid</dt><dd>ZMW @Model.CurrentInvoice.AmountPaid.ToString("N2")</dd></div>
                <div><dt>Outstanding balance</dt><dd>ZMW @Model.CurrentInvoice.Balance.ToString("N2")</dd></div>
                <div><dt>Payment percentage</dt><dd>@Model.CurrentInvoice.PaymentPercentage.ToString("N0")%</dd></div>
                <div><dt>Programme / mode</dt><dd>@Model.CurrentInvoice.ProgrammeName · @Model.CurrentInvoice.StudyModeName</dd></div>
                <div><dt>Payment account</dt><dd>@Model.CurrentInvoice.PaymentAccount</dd></div>
            </dl>
        </article>
        <article class="card-surface action-card">
            <p class="section-kicker">Payment information</p>
            <h2>Payment is informational</h2>
            <p>This prototype does not process money or connect to a live payment system. Use the stated account and retain a reference; the administrator records confirmed payments.</p>
        </article>
    </section>
}

<section class="card-surface">
    <p class="section-kicker">Invoice history</p>
    <h2>Current and previous invoices</h2>
    @if (Model.Invoices.Count == 0)
    {
        <p class="muted-copy">No invoices have been generated yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Invoice</th><th>Period</th><th>Total</th><th>Paid</th><th>Balance</th><th>Payment history</th></tr></thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td><strong>@invoice.InvoiceNumber</strong><br /><span class="muted-copy">@invoice.ProgrammeName · @invoice.StudyModeName</span></td>
                            <td>@invoice.AcademicYear · @invoice.Semester</td>
                            <td>ZMW @invoice.TotalAmount.ToString("N2")</td>
                            <td>ZMW @invoice.AmountPaid.ToString("N2")</td>
                            <td>ZMW @invoice.Balance.ToString("N2")</td>
                            <td>
                                @if (invoice.Payments.Count == 0)
                                {
                                    <span class="muted-copy">No payment records</span>
                                }
                                else
                                {
                                    <ul class="mini-list">
                                        @foreach (var payment in invoice.Payments.OrderByDescending(item => item.PaidAt))
                                        {
                                            <li>ZMW @payment.Amount.ToString("N2") · @payment.Reference · @payment.PaidAt.ToLocalTime().ToString("dd MMM yyyy")</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
