@page
@model AcademicManagementSystem.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<section class="auth-shell">
    <article class="auth-card text-center">
        <h1>Sign out</h1>
        <p class="muted-copy">End this secure session on this device.</p>
        <form method="post">
            <button class="btn btn-primary" type="submit">Sign out</button>
        </form>
    </article>
</section>
